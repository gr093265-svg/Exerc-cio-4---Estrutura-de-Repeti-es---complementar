#include <stdio.h>

int main()
{
    int n;
    int i;

    int anterior = 0;
    int atual = 1;
    int proximo;

    do
    {
        printf("Digite um numero maior ou igual a 0: ");
        scanf("%d", &n);

    } while (n < 0);

    if (n == 0)
    {
        printf("Termo %d: 0\n", n);
    }
    else
    {
        for (i = 2; i <= n; i++)
        {
            proximo = anterior + atual;

            anterior = atual;
            atual = proximo;
        }

        printf("Termo %d: %d\n", n, atual);
    }

    return 0;
}
