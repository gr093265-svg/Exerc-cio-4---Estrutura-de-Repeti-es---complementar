#include <stdio.h>

int main()
{
    int mes, ano, dias;
    char resp;

    do
    {
        do
        {
            printf("\nMes (1 a 12): ");
            scanf("%d", &mes);

        } while (mes < 1 || mes > 12);

        printf("Ano: ");
        scanf("%d", &ano);

        if (mes == 4 || mes == 6 || mes == 9 || mes == 11)
        {
            dias = 30;
        }
        else if (mes == 2)
        {
            if ((ano % 4 == 0 && ano % 100 != 0) ||
                ano % 400 == 0)
            {
                dias = 29;
            }
            else
            {
                dias = 28;
            }
        }
        else
        {
            dias = 31;
        }

        printf("O mes %d/%d tem %d dias.\n",
               mes, ano, dias);

        printf("Deseja outra entrada? (S/N): ");
        scanf(" %c", &resp);

    } while (resp == 'S' || resp == 's');

    return 0;
}
