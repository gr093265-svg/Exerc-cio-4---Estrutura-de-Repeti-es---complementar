#include <stdio.h>

int main()
{
    int cont[3][3] = {0};

    int i, j;
    int e, p;

    int totalElevador[3] = {0};
    int totalPeriodo[3] = {0};

    int maior, menor;
    int elevadorMedio;

    char elevador;
    char periodo;

    for (i = 1; i <= 50; i++)
    {
        do
        {
            printf("\nMorador %d - Elevador (A/B/C): ", i);
            scanf(" %c", &elevador);

        } while (elevador != 'A' &&
                 elevador != 'B' &&
                 elevador != 'C');

        do
        {
            printf("Periodo (M/V/N): ");
            scanf(" %c", &periodo);

        } while (periodo != 'M' &&
                 periodo != 'V' &&
                 periodo != 'N');

        /*
           Transformamos as letras em números:

           A = 0
           B = 1
           C = 2

           M = 0
           V = 1
           N = 2
        */

        if (elevador == 'A')
        {
            e = 0;
        }
        else if (elevador == 'B')
        {
            e = 1;
        }
        else
        {
            e = 2;
        }

        if (periodo == 'M')
        {
            p = 0;
        }
        else if (periodo == 'V')
        {
            p = 1;
        }
        else
        {
            p = 2;
        }

        cont[e][p]++;
    }

    /*
       Calcula o total de cada elevador
       e o total de cada período.
    */

    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            totalElevador[i] =
                totalElevador[i] + cont[i][j];

            totalPeriodo[j] =
                totalPeriodo[j] + cont[i][j];
        }
    }

    /*
       a) Período mais utilizado
    */

    p = 0;

    for (i = 1; i < 3; i++)
    {
        if (totalPeriodo[i] > totalPeriodo[p])
        {
            p = i;
        }
    }

    e = 0;

    for (i = 1; i < 3; i++)
    {
        if (cont[i][p] > cont[e][p])
        {
            e = i;
        }
    }

    printf("\nA) Periodo mais usado: ");

    if (p == 0)
    {
        printf("M");
    }
    else if (p == 1)
    {
        printf("V");
    }
    else
    {
        printf("N");
    }

    printf(" - Elevador: ");

    if (e == 0)
    {
        printf("A\n");
    }
    else if (e == 1)
    {
        printf("B\n");
    }
    else
    {
        printf("C\n");
    }

    /*
       b) Elevador mais frequentado
    */

    e = 0;

    for (i = 1; i < 3; i++)
    {
        if (totalElevador[i] > totalElevador[e])
        {
            e = i;
        }
    }

    p = 0;

    for (j = 1; j < 3; j++)
    {
        if (cont[e][j] > cont[e][p])
        {
            p = j;
        }
    }

    printf("B) Elevador mais frequentado: ");

    if (e == 0)
    {
        printf("A");
    }
    else if (e == 1)
    {
        printf("B");
    }
    else
    {
        printf("C");
    }

    printf(" - Periodo de maior fluxo: ");

    if (p == 0)
    {
        printf("M\n");
    }
    else if (p == 1)
    {
        printf("V\n");
    }
    else
    {
        printf("N\n");
    }

    /*
       c) Diferença percentual entre
       o período mais e menos utilizado
    */

    maior = totalPeriodo[0];
    menor = totalPeriodo[0];

    for (i = 1; i < 3; i++)
    {
        if (totalPeriodo[i] > maior)
        {
            maior = totalPeriodo[i];
        }

        if (totalPeriodo[i] < menor)
        {
            menor = totalPeriodo[i];
        }
    }

    printf("C) Diferenca percentual: %.2f%%\n",
           (maior - menor) * 100.0 / 50);

    /*
       d) Elevador de média utilização
    */

    maior = totalElevador[0];
    menor = totalElevador[0];

    for (i = 1; i < 3; i++)
    {
        if (totalElevador[i] > maior)
        {
            maior = totalElevador[i];
        }

        if (totalElevador[i] < menor)
        {
            menor = totalElevador[i];
        }
    }

    elevadorMedio = 50 - maior - menor;

    printf("D) Elevador de media utilizacao: %.2f%%\n",
           elevadorMedio * 100.0 / 50);

    return 0;
}
