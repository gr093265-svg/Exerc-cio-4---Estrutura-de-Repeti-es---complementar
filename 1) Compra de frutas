#include <stdio.h>

int main()
{
    int opcao, qtd;
    float total = 0;

    do
    {
        printf("\n1 - ABACAXI - R$ 5,00\n");
        printf("2 - MACA - R$ 1,00\n");
        printf("3 - PERA - R$ 4,00\n");
        printf("0 - FINALIZAR COMPRA\n");

        printf("Opcao: ");
        scanf("%d", &opcao);

        if (opcao >= 1 && opcao <= 3)
        {
            printf("Quantidade: ");
            scanf("%d", &qtd);

            if (opcao == 1)
            {
                total = total + qtd * 5;
            }

            if (opcao == 2)
            {
                total = total + qtd * 1;
            }

            if (opcao == 3)
            {
                total = total + qtd * 4;
            }
        }
        else if (opcao != 0)
        {
            printf("Opcao invalida!\n");
        }

    } while (opcao != 0);

    printf("\nValor total da compra: R$ %.2f\n", total);

    return 0;
}
